    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer Email:\nSubject: {{ $json.subject }}\nBody: {{ $json.emailBody }}\n\nAnalyze the customer email and classify it into one of these categories:\n- technical (login issues, bugs, errors, technical problems)\n- billing (payments, refunds, invoices, subscription issues)\n- sales (product inquiries, pricing, demos, new features)\n- urgent (critical issues, angry customers, legal threats, data loss)\n\nAlso identify:\n1. issue summary (brief description)\n2. priority (low, medium, high, critical)\n3. customer intent (what they want to achieve)\n\nReturn JSON with category, summary, priority, and intent.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI customer support classification agent. Analyze customer emails and classify them accurately into technical, billing, sales, or urgent categories."
        }
      },
      "id": "06015206-1889-41b7-8ca4-f24c5e3a0a65",
